                  "    pm.expect(json.category).to.be.a('string');\r",
                  "});\r",
                  "\r",
                  "pm.test(\"JSON Schema is valid\", function(){\r",
                  "    const schema = {\r",
                  "        type: \"object\",\r",
                  "        required: [\"id\", \"title\", \"price\", \"description\", \"category\", \"image\", \"rating\"],\r",
                  "        properties: {\r",
                  "            id:          { type: \"number\" },\r",
                  "            title:       { type: \"string\" },\r",
                  "            price:       { type: \"number\" },\r",
                  "            description: { type: \"string\" },\r",
                  "            category:    { type: \"string\" },\r",
                  "            image:       { type: \"string\" },\r",
                  "            rating:  {\r",
                  "                type: \"object\",\r",
                  "                required: [\"rate\", \"count\"],\r",
                  "                properties: {\r",
                  "                    rate:  { type: \"number\" },\r",
                  "                    count: { type: \"number\" }\r",
                  "                }\r",
                  "            }\r",
                  "        }   \r",
                  "    };\r",
                  "    pm.response.to.have.jsonSchema(schema);\r",
                  "});"
